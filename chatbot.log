define user ask for information
  when
    user said something
    $knowledgeBase = recall knowledge base information
    $knowledgeBase matches user message
  then
    bot only use information from $knowledgeBase
    bot avoid making up information not present in $knowledgeBase
    bot avoid phrases like "based on the information provided" or "according to the provided context"
    bot respond in a natural, helpful tone while strictly adhering to facts in $knowledgeBase

define user ask for personal advice
  when 
